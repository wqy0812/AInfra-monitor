{
  "kind": "Dashboard",
  "metadata": {
    "name": "overview",
    "project": "dcu-monitoring"
  },
  "spec": {
    "display": {
      "name": "运行概览",
      "description": "数据源：test4 VictoriaMetrics。缺失或无效观测留空；默认 1 小时 / 15 秒刷新。"
    },
    "duration": "1h",
    "refreshInterval": "15s",
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "role",
          "display": {
            "name": "角色"
          },
          "defaultValue": ".*",
          "plugin": {
            "kind": "StaticListVariable",
            "spec": {
              "values": [
                {
                  "value": ".*",
                  "label": "全部"
                },
                {
                  "value": "prefill",
                  "label": "Prefill / dcu1"
                },
                {
                  "value": "decode",
                  "label": "Decode / dcu2"
                }
              ]
            }
          }
        }
      }
    ],
    "panels": {
      "p0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "采集目标状态",
            "description": ""
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "yAxis": {
                "label": "1 = 正常",
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1,
                "connectNulls": false
              },
              "tooltip": {
                "enablePinning": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "up{environment=\"dcu-pd\"} and (time() - timestamp(up{environment=\"dcu-pd\"}) < 15)",
                    "seriesNameFormat": "{{job}}",
                    "minStep": "5s"
                  }
                }
              }
            }
          ]
        }
      },
      "p1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "推理请求速率",
            "description": ""
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "yAxis": {
                "label": "请求 / 秒",
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1,
                "connectNulls": false
              },
              "tooltip": {
                "enablePinning": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(monitoring_chart_value{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.requests\"} and (monitoring_chart_valid{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.requests\"} == 1) and (min_over_time(monitoring_chart_valid{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.requests\"}[$__interval]) == 1) and (count_over_time(monitoring_chart_valid{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.requests\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(monitoring_chart_value{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.requests\"}) < 15)) * 1",
                    "seriesNameFormat": "{{path}}",
                    "minStep": "5s"
                  }
                }
              }
            }
          ]
        }
      },
      "p2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "输出 Token 吞吐",
            "description": "源监控 output_tokens 有效性为 0 时留空，不补零；实时生成速度请同时查看 Decode Token 吞吐。"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "yAxis": {
                "label": "Token / 秒",
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1,
                "connectNulls": false
              },
              "tooltip": {
                "enablePinning": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(monitoring_chart_value{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.output_tokens\"} and (monitoring_chart_valid{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.output_tokens\"} == 1) and (min_over_time(monitoring_chart_valid{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.output_tokens\"}[$__interval]) == 1) and (count_over_time(monitoring_chart_valid{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.output_tokens\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(monitoring_chart_value{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.output_tokens\"}) < 15)) * 1",
                    "seriesNameFormat": "{{path}}",
                    "minStep": "5s"
                  }
                }
              }
            }
          ]
        }
      },
