                    "query": "(monitoring_chart_value{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.decode_tokens\"} and (monitoring_chart_valid{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.decode_tokens\"} == 1) and (min_over_time(monitoring_chart_valid{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.decode_tokens\"}[$__interval]) == 1) and (count_over_time(monitoring_chart_valid{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.decode_tokens\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(monitoring_chart_value{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.decode_tokens\"}) < 15)) * 1",
                    "seriesNameFormat": "{{path}}",
                    "minStep": "5s"
