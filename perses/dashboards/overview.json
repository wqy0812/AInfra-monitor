          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(monitoring_chart_value{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.ttft.p50\"} and (monitoring_chart_valid{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.ttft.p50\"} == 1) and (min_over_time(monitoring_chart_valid{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.ttft.p50\"}[$__interval]) == 1) and (count_over_time(monitoring_chart_valid{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.ttft.p50\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(monitoring_chart_value{environment=\"dcu-pd\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.ttft.p50\"}) < 15)) * 1",
