{
  "kind": "Dashboard",
  "metadata": {
    "name": "gateway",
    "project": "dcu-monitoring"
  },
  "spec": {
    "display": {
      "name": "网关基础状态",
      "description": "数据源：test4 VictoriaMetrics。缺失或无效观测留空；默认 1 小时 / 15 秒刷新。"
    },
    "duration": "1h",
    "refreshInterval": "15s",
    "variables": [],
    "panels": {
      "p0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "在途请求",
            "description": ""
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "yAxis": {
                "label": "请求",
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1,
                "connectNulls": false
              },
              "tooltip": {
                "enablePinning": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(aigate_requests_inflight{job=\"aigate\",request_scope=\"streaming\"}) and on(job,instance) ((min_over_time(up{environment=\"dcu-pd\",job=~\"aigate\"}[$__interval]) == 1) and (count_over_time(up{environment=\"dcu-pd\",job=~\"aigate\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(up{environment=\"dcu-pd\",job=~\"aigate\"}) < 15))",
                    "seriesNameFormat": "在途",
                    "minStep": "5s"
                  }
                }
              }
            }
          ]
        }
      },
      "p1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "请求到达速率",
            "description": "1 分钟窗口；生命周期变化、计数重置和采集断档留空。"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "yAxis": {
                "label": "请求 / 秒",
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1,
                "connectNulls": false
              },
              "tooltip": {
                "enablePinning": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(rate(aigate_requests_started_total{job=\"aigate\",request_scope=\"streaming\"}[1m]) and (resets(aigate_requests_started_total{job=\"aigate\",request_scope=\"streaming\"}[1m]) == 0) and (count_over_time(aigate_requests_started_total{job=\"aigate\",request_scope=\"streaming\"}[1m]) >= 12)) and on(job,instance) ((min_over_time(up{environment=\"dcu-pd\",job=~\"aigate\"}[$__interval]) == 1) and (count_over_time(up{environment=\"dcu-pd\",job=~\"aigate\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(up{environment=\"dcu-pd\",job=~\"aigate\"}) < 15)) and on(job,instance) ((changes(aigate_profile_counter_start_time_seconds{job=\"aigate\",request_scope=\"streaming\"}[1m]) == 0) and (count_over_time(aigate_profile_counter_start_time_seconds{job=\"aigate\",request_scope=\"streaming\"}[1m]) >= 12) and (time() - aigate_profile_counter_start_time_seconds{job=\"aigate\",request_scope=\"streaming\"} >= 60) and (min_over_time(up{job=\"aigate\"}[1m]) == 1) and (count_over_time(up{job=\"aigate\"}[1m]) >= 12))",
                    "seriesNameFormat": "到达",
                    "minStep": "5s"
                  }
                }
              }
            }
          ]
        }
      },
      "p2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "画像队列",
            "description": ""
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "yAxis": {
                "label": "事件",
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1,
                "connectNulls": false
              },
              "tooltip": {
                "enablePinning": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(aigate_profile_queue_events{job=\"aigate\",request_scope=\"streaming\"}) and on(job,instance) ((min_over_time(up{environment=\"dcu-pd\",job=~\"aigate\"}[$__interval]) == 1) and (count_over_time(up{environment=\"dcu-pd\",job=~\"aigate\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(up{environment=\"dcu-pd\",job=~\"aigate\"}) < 15))",
                    "seriesNameFormat": "画像队列",
                    "minStep": "5s"
                  }
                }
              }
            }
          ]
        }
      },
      "p3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "画像索引条目",
            "description": ""
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "yAxis": {
                "label": "条目",
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1,
                "connectNulls": false
              },
              "tooltip": {
                "enablePinning": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(aigate_profile_index_entries{job=\"aigate\",request_scope=\"streaming\"}) and on(job,instance) ((min_over_time(up{environment=\"dcu-pd\",job=~\"aigate\"}[$__interval]) == 1) and (count_over_time(up{environment=\"dcu-pd\",job=~\"aigate\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(up{environment=\"dcu-pd\",job=~\"aigate\"}) < 15))",
                    "seriesNameFormat": "画像索引条目",
                    "minStep": "5s"
                  }
                }
              }
            }
          ]
        }
      },
      "p4": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "画像索引就绪",
            "description": ""
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "yAxis": {
                "label": "1 = 就绪",
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1,
                "connectNulls": false
              },
              "tooltip": {
                "enablePinning": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(aigate_profile_index_ready{job=\"aigate\",request_scope=\"streaming\"}) and on(job,instance) ((min_over_time(up{environment=\"dcu-pd\",job=~\"aigate\"}[$__interval]) == 1) and (count_over_time(up{environment=\"dcu-pd\",job=~\"aigate\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(up{environment=\"dcu-pd\",job=~\"aigate\"}) < 15))",
                    "seriesNameFormat": "画像索引就绪",
                    "minStep": "5s"
                  }
                }
              }
            }
          ]
        }
      },
      "p5": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "画像写入错误速率",
            "description": ""
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "yAxis": {
                "label": "事件 / 秒",
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1,
                "connectNulls": false
              },
              "tooltip": {
                "enablePinning": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(rate(aigate_profile_write_errors_total{job=\"aigate\",request_scope=\"streaming\"}[1m]) and (resets(aigate_profile_write_errors_total{job=\"aigate\",request_scope=\"streaming\"}[1m]) == 0) and (count_over_time(aigate_profile_write_errors_total{job=\"aigate\",request_scope=\"streaming\"}[1m]) >= 12)) and on(job,instance) ((min_over_time(up{environment=\"dcu-pd\",job=~\"aigate\"}[$__interval]) == 1) and (count_over_time(up{environment=\"dcu-pd\",job=~\"aigate\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(up{environment=\"dcu-pd\",job=~\"aigate\"}) < 15)) and on(job,instance) ((changes(aigate_profile_counter_start_time_seconds{job=\"aigate\",request_scope=\"streaming\"}[1m]) == 0) and (count_over_time(aigate_profile_counter_start_time_seconds{job=\"aigate\",request_scope=\"streaming\"}[1m]) >= 12) and (time() - aigate_profile_counter_start_time_seconds{job=\"aigate\",request_scope=\"streaming\"} >= 60) and (min_over_time(up{job=\"aigate\"}[1m]) == 1) and (count_over_time(up{job=\"aigate\"}[1m]) >= 12))",
                    "seriesNameFormat": "画像写入错误速率",
                    "minStep": "5s"
                  }
                }
              }
            }
          ]
        }
      },
      "p6": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "画像事件丢弃速率",
            "description": ""
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "yAxis": {
                "label": "事件 / 秒",
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1,
                "connectNulls": false
              },
              "tooltip": {
                "enablePinning": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(rate(aigate_profile_dropped_events_total{job=\"aigate\",request_scope=\"streaming\"}[1m]) and (resets(aigate_profile_dropped_events_total{job=\"aigate\",request_scope=\"streaming\"}[1m]) == 0) and (count_over_time(aigate_profile_dropped_events_total{job=\"aigate\",request_scope=\"streaming\"}[1m]) >= 12)) and on(job,instance) ((min_over_time(up{environment=\"dcu-pd\",job=~\"aigate\"}[$__interval]) == 1) and (count_over_time(up{environment=\"dcu-pd\",job=~\"aigate\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(up{environment=\"dcu-pd\",job=~\"aigate\"}) < 15)) and on(job,instance) ((changes(aigate_profile_counter_start_time_seconds{job=\"aigate\",request_scope=\"streaming\"}[1m]) == 0) and (count_over_time(aigate_profile_counter_start_time_seconds{job=\"aigate\",request_scope=\"streaming\"}[1m]) >= 12) and (time() - aigate_profile_counter_start_time_seconds{job=\"aigate\",request_scope=\"streaming\"} >= 60) and (min_over_time(up{job=\"aigate\"}[1m]) == 1) and (count_over_time(up{job=\"aigate\"}[1m]) >= 12))",
                    "seriesNameFormat": "画像事件丢弃速率",
                    "minStep": "5s"
                  }
                }
              }
            }
          ]
        }
      },
      "p7": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "画像存储量",
            "description": ""
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "yAxis": {
                "label": "MiB",
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1,
                "connectNulls": false
              },
              "tooltip": {
                "enablePinning": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(aigate_profile_stored_bytes{job=\"aigate\",request_scope=\"streaming\"} / 1024^2) and on(job,instance) ((min_over_time(up{environment=\"dcu-pd\",job=~\"aigate\"}[$__interval]) == 1) and (count_over_time(up{environment=\"dcu-pd\",job=~\"aigate\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(up{environment=\"dcu-pd\",job=~\"aigate\"}) < 15))",
                    "seriesNameFormat": "存储",
                    "minStep": "5s"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/p0"
              }
            },
            {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/p1"
              }
            },
            {
              "x": 0,
              "y": 8,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/p2"
              }
            },
            {
              "x": 12,
              "y": 8,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/p3"
              }
            },
            {
              "x": 0,
              "y": 16,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/p4"
              }
            },
            {
              "x": 12,
              "y": 16,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/p5"
              }
            },
            {
              "x": 0,
              "y": 24,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/p6"
              }
            },
            {
              "x": 12,
              "y": 24,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/p7"
              }
            }
          ]
        }
      }
    ]
  }
}
