                  "spec": {
                    "query": "(monitoring_chart_value{environment=\"a3-vllm\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.e2e.p95\"} and (monitoring_chart_valid{environment=\"a3-vllm\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.e2e.p95\"} == 1) and (min_over_time(monitoring_chart_valid{environment=\"a3-vllm\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.e2e.p95\"}[$__interval]) == 1) and (count_over_time(monitoring_chart_valid{environment=\"a3-vllm\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.e2e.p95\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(monitoring_chart_value{environment=\"a3-vllm\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.e2e.p95\"}) < 15)) * 1",
