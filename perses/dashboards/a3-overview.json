            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(monitoring_chart_value{environment=\"a3-vllm\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.itl.p95\"} and (monitoring_chart_valid{environment=\"a3-vllm\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.itl.p95\"} == 1) and (min_over_time(monitoring_chart_valid{environment=\"a3-vllm\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.itl.p95\"}[$__interval]) == 1) and (count_over_time(monitoring_chart_valid{environment=\"a3-vllm\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.itl.p95\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(monitoring_chart_value{environment=\"a3-vllm\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.itl.p95\"}) < 15)) * 1000",
                    "seriesNameFormat": "{{path}}",
                    "minStep": "5s"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(monitoring_chart_value{environment=\"a3-vllm\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.itl.p99\"} and (monitoring_chart_valid{environment=\"a3-vllm\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.itl.p99\"} == 1) and (min_over_time(monitoring_chart_valid{environment=\"a3-vllm\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.itl.p99\"}[$__interval]) == 1) and (count_over_time(monitoring_chart_valid{environment=\"a3-vllm\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.itl.p99\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(monitoring_chart_value{environment=\"a3-vllm\",schema=\"request-streaming-v1\",path=~\"nodes.$role.percentiles.itl.p99\"}) < 15)) * 1000",
