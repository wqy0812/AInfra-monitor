{
  "kind": "Dashboard",
  "metadata": {
    "name": "cache-store",
    "project": "dcu-monitoring"
  },
  "spec": {
    "display": {
      "name": "HiCache 与 Mooncake",
      "description": "数据源：test4 VictoriaMetrics。缺失或无效观测留空；默认 1 小时 / 15 秒刷新。"
    },
    "duration": "1h",
    "refreshInterval": "15s",
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "role",
          "display": {
            "name": "角色"
          },
          "defaultValue": ".*",
          "plugin": {
            "kind": "StaticListVariable",
            "spec": {
              "values": [
                {
                  "value": ".*",
                  "label": "全部"
                },
                {
                  "value": "prefill",
                  "label": "Prefill / dcu1"
                },
                {
                  "value": "decode",
                  "label": "Decode / dcu2"
                }
              ]
            }
          }
        }
      }
    ],
    "panels": {
      "p0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "模型缓存命中率",
            "description": "缓存窗口约 60 秒。Store 查询命中不等同于模型 Token 命中、读取成功或物理 SSD I/O；SSD 容量是后端配额。"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "yAxis": {
                "label": "%",
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1,
                "connectNulls": false
              },
              "tooltip": {
                "enablePinning": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(monitoring_chart_value{environment=\"dcu-pd\",schema=\"v1\",path=~\"nodes.$role.cache_60s.ratio\"} and (monitoring_chart_valid{environment=\"dcu-pd\",schema=\"v1\",path=~\"nodes.$role.cache_60s.ratio\"} == 1) and (min_over_time(monitoring_chart_valid{environment=\"dcu-pd\",schema=\"v1\",path=~\"nodes.$role.cache_60s.ratio\"}[$__interval]) == 1) and (count_over_time(monitoring_chart_valid{environment=\"dcu-pd\",schema=\"v1\",path=~\"nodes.$role.cache_60s.ratio\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(monitoring_chart_value{environment=\"dcu-pd\",schema=\"v1\",path=~\"nodes.$role.cache_60s.ratio\"}) < 15)) * 100",
                    "seriesNameFormat": "{{path}}",
                    "minStep": "5s"
                  }
                }
              }
            }
          ]
        }
      },
      "p1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "缓存命中分层",
            "description": "缓存窗口约 60 秒。Store 查询命中不等同于模型 Token 命中、读取成功或物理 SSD I/O；SSD 容量是后端配额。"
          },
          "plugin": {
