                  "spec": {
                    "query": "(monitoring_chart_value{environment=\"dcu-pd\",schema=\"v1\",path=~\"mooncake.capacity.(used|total)\"} and (monitoring_chart_valid{environment=\"dcu-pd\",schema=\"v1\",path=~\"mooncake.capacity.(used|total)\"} == 1) and (min_over_time(monitoring_chart_valid{environment=\"dcu-pd\",schema=\"v1\",path=~\"mooncake.capacity.(used|total)\"}[$__interval]) == 1) and (count_over_time(monitoring_chart_valid{environment=\"dcu-pd\",schema=\"v1\",path=~\"mooncake.capacity.(used|total)\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(monitoring_chart_value{environment=\"dcu-pd\",schema=\"v1\",path=~\"mooncake.capacity.(used|total)\"}) < 15)) * 9.313225746154785e-10",
                    "seriesNameFormat": "{{path}}",
                    "minStep": "5s"
                  }
                }
              }
            }
          ]
        }
      },
