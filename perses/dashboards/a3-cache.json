{
  "kind": "Dashboard",
  "metadata": {
    "name": "a3-cache",
    "project": "dcu-monitoring"
  },
  "spec": {
    "display": {
      "name": "A3 · 缓存",
      "description": "数据源：test4 VictoriaMetrics。缺失或无效观测留空；默认 1 小时 / 15 秒刷新。"
    },
    "duration": "1h",
    "refreshInterval": "15s",
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "role",
          "display": {
            "name": "角色"
          },
          "defaultValue": ".*",
          "plugin": {
            "kind": "StaticListVariable",
            "spec": {
              "values": [
                {
                  "value": ".*",
                  "label": "全部"
                },
                {
                  "value": "prefill",
                  "label": "Prefill / A3-1"
                },
                {
                  "value": "decode",
                  "label": "Decode / A3-2"
                }
              ]
            }
          }
        }
      }
    ],
    "panels": {
      "p0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "实例 KV 缓存占用",
            "description": "vLLM KV-cache usage；不是 NPU 显存总使用率。"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "yAxis": {
                "label": "%",
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1,
                "connectNulls": false
              },
              "tooltip": {
                "enablePinning": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(monitoring_chart_value{environment=\"a3-vllm\",schema=\"v1\",path=~\"nodes.$role.resources.kv_usage..*\"} and (monitoring_chart_valid{environment=\"a3-vllm\",schema=\"v1\",path=~\"nodes.$role.resources.kv_usage..*\"} == 1) and (min_over_time(monitoring_chart_valid{environment=\"a3-vllm\",schema=\"v1\",path=~\"nodes.$role.resources.kv_usage..*\"}[$__interval]) == 1) and (count_over_time(monitoring_chart_valid{environment=\"a3-vllm\",schema=\"v1\",path=~\"nodes.$role.resources.kv_usage..*\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(monitoring_chart_value{environment=\"a3-vllm\",schema=\"v1\",path=~\"nodes.$role.resources.kv_usage..*\"}) < 15)) * 100",
                    "seriesNameFormat": "{{path}}",
                    "minStep": "5s"
                  }
                }
              }
            }
          ]
        }
      },
      "p1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "本地前缀缓存命中率",
            "description": "最近约 60 秒；按 Token 加权，无查询留空。本地前缀命中 Token / 查询 Token。"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "yAxis": {
                "label": "%",
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1,
                "connectNulls": false
              },
              "tooltip": {
                "enablePinning": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(monitoring_chart_value{environment=\"a3-vllm\",schema=\"v1\",path=~\"nodes.$role.cache_60s.ratio\"} and (monitoring_chart_valid{environment=\"a3-vllm\",schema=\"v1\",path=~\"nodes.$role.cache_60s.ratio\"} == 1) and (min_over_time(monitoring_chart_valid{environment=\"a3-vllm\",schema=\"v1\",path=~\"nodes.$role.cache_60s.ratio\"}[$__interval]) == 1) and (count_over_time(monitoring_chart_valid{environment=\"a3-vllm\",schema=\"v1\",path=~\"nodes.$role.cache_60s.ratio\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(monitoring_chart_value{environment=\"a3-vllm\",schema=\"v1\",path=~\"nodes.$role.cache_60s.ratio\"}) < 15)) * 100",
                    "seriesNameFormat": "{{path}}",
                    "minStep": "5s"
                  }
                }
              }
            }
          ]
        }
      },
      "p2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "外部前缀缓存命中率",
            "description": "最近约 60 秒；按 Token 加权，无查询留空。跨实例 KV 共享命中 Token / 查询 Token；不表示 HiCache CPU、Mooncake Store 或 SSD 命中。"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "yAxis": {
                "label": "%",
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1,
                "connectNulls": false
              },
              "tooltip": {
                "enablePinning": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(monitoring_chart_value{environment=\"a3-vllm\",schema=\"v1\",path=~\"nodes.$role.cache_60s.external_ratio\"} and (monitoring_chart_valid{environment=\"a3-vllm\",schema=\"v1\",path=~\"nodes.$role.cache_60s.external_ratio\"} == 1) and (min_over_time(monitoring_chart_valid{environment=\"a3-vllm\",schema=\"v1\",path=~\"nodes.$role.cache_60s.external_ratio\"}[$__interval]) == 1) and (count_over_time(monitoring_chart_valid{environment=\"a3-vllm\",schema=\"v1\",path=~\"nodes.$role.cache_60s.external_ratio\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(monitoring_chart_value{environment=\"a3-vllm\",schema=\"v1\",path=~\"nodes.$role.cache_60s.external_ratio\"}) < 15)) * 100",
                    "seriesNameFormat": "{{path}}",
                    "minStep": "5s"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/p0"
              }
            },
            {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/p1"
              }
            },
            {
              "x": 0,
              "y": 8,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/p2"
              }
            }
          ]
        }
      }
    ]
  }
}
