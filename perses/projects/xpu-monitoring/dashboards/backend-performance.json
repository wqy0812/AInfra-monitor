            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "5s",
                    "query": "sort_by_label((label_replace((label_replace((label_replace(((monitoring_chart_value{environment=\"xpu-pd\",schema=\"request-metrics-v2\",path=~\"nodes.$role.percentiles.ttft.(p50|p95|p99)\"} and (monitoring_chart_valid{environment=\"xpu-pd\",schema=\"request-metrics-v2\",path=~\"nodes.$role.percentiles.ttft.(p50|p95|p99)\"} == 1) and (min_over_time(monitoring_chart_valid{environment=\"xpu-pd\",schema=\"request-metrics-v2\",path=~\"nodes.$role.percentiles.ttft.(p50|p95|p99)\"}[$__interval]) == 1) and (count_over_time(monitoring_chart_valid{environment=\"xpu-pd\",schema=\"request-metrics-v2\",path=~\"nodes.$role.percentiles.ttft.(p50|p95|p99)\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(monitoring_chart_value{environment=\"xpu-pd\",schema=\"request-metrics-v2\",path=~\"nodes.$role.percentiles.ttft.(p50|p95|p99)\"}) < 15)) * 1), \"perses_order\", \"00\", \"path\", \".*[.]p50\")), \"perses_order\", \"01\", \"path\", \".*[.]p95\")), \"perses_order\", \"02\", \"path\", \".*[.]p99\")), \"perses_order\", \"path\")",
                    "seriesNameFormat": "{{path}}"
                  }
                }
              }
            }
          ]
        }
