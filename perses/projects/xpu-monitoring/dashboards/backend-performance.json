                    "seriesNameFormat": "{{path}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "5s",
                    "query": "(monitoring_chart_value{environment=\"xpu-pd\",schema=\"request-metrics-v2\",path=~\"nodes.$role.percentiles.e2e.samples\"} and (monitoring_chart_valid{environment=\"xpu-pd\",schema=\"request-metrics-v2\",path=~\"nodes.$role.percentiles.e2e.samples\"} == 1) and (min_over_time(monitoring_chart_valid{environment=\"xpu-pd\",schema=\"request-metrics-v2\",path=~\"nodes.$role.percentiles.e2e.samples\"}[$__interval]) == 1) and (count_over_time(monitoring_chart_valid{environment=\"xpu-pd\",schema=\"request-metrics-v2\",path=~\"nodes.$role.percentiles.e2e.samples\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(monitoring_chart_value{environment=\"xpu-pd\",schema=\"request-metrics-v2\",path=~\"nodes.$role.percentiles.e2e.samples\"}) < 15)) * 1",
