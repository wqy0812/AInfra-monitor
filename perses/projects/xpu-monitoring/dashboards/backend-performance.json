          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "5s",
                    "query": "(monitoring_chart_value{environment=\"xpu-pd\",schema=\"request-metrics-v2\",path=~\"nodes.$role.requests\"} and (monitoring_chart_valid{environment=\"xpu-pd\",schema=\"request-metrics-v2\",path=~\"nodes.$role.requests\"} == 1) and (min_over_time(monitoring_chart_valid{environment=\"xpu-pd\",schema=\"request-metrics-v2\",path=~\"nodes.$role.requests\"}[$__interval]) == 1) and (count_over_time(monitoring_chart_valid{environment=\"xpu-pd\",schema=\"request-metrics-v2\",path=~\"nodes.$role.requests\"}[$__interval]) >= ($__interval / 5)) and (time() - timestamp(monitoring_chart_value{environment=\"xpu-pd\",schema=\"request-metrics-v2\",path=~\"nodes.$role.requests\"}) < 15)) * 1",
                    "seriesNameFormat": "{{path}}"
                  }
                }
              }
            }
          ]
        }
