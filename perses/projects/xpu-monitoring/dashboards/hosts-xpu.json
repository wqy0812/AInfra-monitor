{
  "kind": "Dashboard",
  "metadata": {
    "name": "hosts-xpu",
    "project": "xpu-monitoring"
  },
  "spec": {
    "display": {
      "name": "主机与 XPU",
      "description": "XPU 独立环境；请求为原生全量口径，P/D 不相加为唯一请求量。缺失、过期、重置、无分母留空。HiCache、缓存层级、主机和卡硬件暂未接入；网关画像单独采集。"
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "display": {
            "name": "节点",
            "hidden": false
          },
          "defaultValue": ".*",
          "allowAllValue": false,
          "allowMultiple": false,
          "plugin": {
            "kind": "StaticListVariable",
            "spec": {
              "values": [
                {
                  "label": "全部（未接入）",
                  "value": ".*"
                }
              ]
            }
          },
          "name": "node"
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "display": {
            "name": "XPU",
            "hidden": false
          },
          "defaultValue": ".*",
          "allowAllValue": false,
          "allowMultiple": false,
          "plugin": {
            "kind": "StaticListVariable",
            "spec": {
              "values": [
                {
                  "label": "全部（未接入）",
                  "value": ".*"
                }
              ]
            }
          },
          "name": "device"
        }
      }
    ],
    "panels": {
      "extra-fs-free": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "文件系统剩余容量",
            "description": "硬件监控暂未接入。本面板有意留空，No data 不表示零。"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "bottom"
              },
              "tooltip": {
                "enablePinning": true
              },
              "visual": {
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              },
              "yAxis": {
                "label": "GiB",
                "min": 0
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "5s",
                    "query": "vector(0) unless on() vector(0)",
                    "seriesNameFormat": "{{node}} · {{mountpoint}}"
                  }
                }
              }
            }
          ]
        }
      },
      "extra-iowait": {
